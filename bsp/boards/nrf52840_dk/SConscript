import os

Import('env')

localEnv = env.Clone()

# The nrf52840_dk board in this fork ships a flat SEGGER Embedded Studio-style
# SDK under sdk/ (no nRF5 SDK components/modules tree). The SES build (see
# projects/nrf52840_dk/nrf52840_dk.emProject and Output/Debug/Obj/*_files.ind)
# compiles only these SDK files plus the board .c files next to this SConscript.
source = \
    Glob('sdk/system_nrf52840.c') + \
    Glob('sdk/ses_startup_nrf52840.s') + \
    Glob('sdk/ses_startup_nrf_common.s') + \
    Glob('sdk/thumb_crt0.s') + \
    Glob('*.c')

localEnv.Append(
    CPPPATH=[
        os.path.join('#', 'bsp', 'boards', 'nrf52840_dk'),
        os.path.join('#', 'bsp', 'boards', 'nrf52840_dk', 'sdk'),
    ],
)

board = localEnv.Object(source=source)

Return('board')
